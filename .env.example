# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit it. These are session credentials for your own ESPN account,
# equivalent to an API key: treat them the same way (don't paste them into
# chat, don't share the file).

# "espn" switches the roster-state interface (requirement 1) over to the
# live ESPN connector. Leave unset or "manual" to keep using the CSV/YAML
# files in data/roster_state/.
EDGE_ENGINE_ROSTER_SOURCE=espn

# --- League identifiers ---
# League ID: visible in the URL when you view your league on espn.com,
# e.g. https://fantasy.espn.com/football/league?leagueId=123456 -> 123456
ESPN_LEAGUE_ID=

# The NFL season year, e.g. 2026
ESPN_YEAR=2026

# Team ID: visible in the URL when you view YOUR team's page,
# e.g. https://fantasy.espn.com/football/team?leagueId=123456&teamId=4 -> 4
ESPN_TEAM_ID=

# --- Auth cookies (private leagues only) ---
# Log into your league at fantasy.espn.com in a normal browser, then:
#   Chrome/Edge: DevTools (F12) -> Application tab -> Cookies -> https://fantasy.espn.com
#   Firefox: DevTools (F12) -> Storage tab -> Cookies -> https://fantasy.espn.com
# Find the rows named "espn_s2" and "SWID" and copy their Value column here.
# SWID includes the surrounding curly braces, e.g. {ABCD1234-...}
ESPN_S2=
ESPN_SWID=
